# Hermes AI Agent Configuration

# ===== LLM Provider Keys (at least one required) =====

# OpenRouter (recommended for cost-effective multi-model access)
# Sign up: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# Anthropic Claude API
# Sign up: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API
# Sign up: https://platform.openai.com
OPENAI_API_KEY=sk-...

# Google API (for Gemini)
# Sign up: https://console.cloud.google.com
GOOGLE_API_KEY=...

# ===== Hermes Configuration =====

# Web UI Password/Authentication Token
# Used to secure access to the Hermes web interface
SERVICE_PASSWORD_HERMESWEBUI=change_this_to_a_strong_password

# Public URL (automatically set by Coolify routing)
# Example: https://hermes.example.com
SERVICE_URL_HERMESWEBUI_8787=
